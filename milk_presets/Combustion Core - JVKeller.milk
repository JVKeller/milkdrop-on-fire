MILKDROP_PRESET_VERSION=201
PSVERSION=2
PSVERSION_WARP=2
PSVERSION_COMP=2
[preset00]
# Identical convection + blackbody model to "Combustion", with the composite
# shader removed. If "Combustion" renders black or fails to load but this one
# works, the problem is GetBlur1/GetBlur2 (the bloom taps), not the core
# blackbody warp shader. fGammaAdj compensates for the missing tone curve.
fRating=5.000
fGammaAdj=1.350
fDecay=0.972
fVideoEchoZoom=1.000
fVideoEchoAlpha=0.000
nVideoEchoOrientation=0
nWaveMode=0
bAdditiveWaves=0
bWaveDots=0
bWaveThick=0
bModWaveAlphaByVolume=0
bMaximizeWaveColor=0
bTexWrap=0
bDarkenCenter=0
bRedBlueStereo=0
bBrighten=0
bDarken=0
bSolarize=0
bInvert=0
fWaveAlpha=0.000
fWaveScale=1.000
fWaveSmoothing=0.000
fWaveParam=0.000
fModWaveAlphaStart=0.750
fModWaveAlphaEnd=0.950
fWarpAnimSpeed=1.600
fWarpScale=2.200
fZoomExponent=1.000
nMotionVectorsX=0.000
nMotionVectorsY=0.000
mv_dx=0.000
mv_dy=0.000
mv_l=0.000
mv_r=0.000
mv_g=0.000
mv_b=0.000
mv_a=0.000
zoom=1.000
rot=0.000
cx=0.500
cy=1.000
dx=0.000
dy=0.000
warp=0.000
sx=1.000
sy=1.000
wave_r=1.000
wave_g=1.000
wave_b=1.000
wave_x=0.500
wave_y=0.500
ob_size=0.000
ob_r=0.000
ob_g=0.000
ob_b=0.000
ob_a=0.000
ib_size=0.000
ib_r=0.000
ib_g=0.000
ib_b=0.000
ib_a=0.000

bars_mode=1
bars_num_x=128
bars_num_y=24
bars_spacing_x=0.000
bars_spacing_y=0.000
bars_x=0.000
bars_y=0.000
bars_rot=0
bars_sx=1.000
bars_sy=0.300
bars_rounding=0
bars_smooth=0.500
bars_sensitivity=0.650
bars_bass_sensitivity=0.550

bars_color_b=0xFFFFF6E2
bars_color_t=0xFFFF7A18
bars_color_l=0x00000000
bars_color_r=0x00000000

bars_thr=0.720
bars_thr_color_b=0xFFFFD98A
bars_thr_color_t=0xFFFFFFFF
bars_thr_color_l=0x00000000
bars_thr_color_r=0x00000000

per_frame_1=q1 = 0.60 + 0.55*bass_att;
per_frame_2=q2 = 0.50 + 0.55*treb_att;
per_frame_3=decay = 0.9720 + 0.0150*bass_att;
per_frame_4=decay = min(decay, 0.9950);

per_pixel_1=ht = 1 - y;
per_pixel_2=dy = -(0.0045 + 0.0130*ht)*q1;
per_pixel_3=dx = 0.0075*ht*ht*sin(x*8.0 + time*1.9 + ht*4.5);
per_pixel_4=dx = dx + 0.0038*ht*sin(x*19.0 - time*3.1)*q2;
per_pixel_5=dx = dx + (0.5 - x)*0.0070*ht;
per_pixel_6=sy = 1 + 0.006*ht;
per_pixel_7=warp = 0.10*ht;

warp_1=`shader_body
warp_2=`{
warp_3=`    float3 c = tex2D(sampler_fc_main, uv).xyz;
warp_4=`    c *= float3(0.9880, 0.9550, 0.9160);
warp_5=`    c = max(c - 0.0030, 0.0);
warp_6=`    ret = c;
warp_7=`}
